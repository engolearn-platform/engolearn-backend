# ===============================================
# MongoDB Credentials & Database Setup
# ===============================================
MONGO_HOST=127.0.0.1
MONGO_PORT=27019
MONGO_USER=root
MONGO_PASS=secret123

APP_DB=engolearn_db
APP_USER=admin
APP_PASSWORD=admin123

# ===============================================
# Mongo Express Web UI Authentication
# ===============================================
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=admin123

CORS_ALLOWED_ORIGINS=http://localhost:3000


AUTH_JWT_SECRET=replace-with-random-32-byte-minimum-secret
AUTH_JWT_ISSUER=engolearn
# Local HTTP only. Set true behind HTTPS; dev profile already defaults to false.
AUTH_COOKIE_SECURE=false

# Real cookie auth is used in every profile. Placement local setup activates
# dev,placement-local explicitly; do not put spring.profiles.active or Placement
# repository switches in .env because the Maven tests also read this file.
# tools/placement/setup-local.ps1 initializes a missing .env and JWT secret.
# MONGO_PORT is the host port; Compose uses mongodb:27017 internally.
# Existing Docker volumes keep their original DB users/passwords; editing these
# variables does not recreate or reset users in an existing volume.
