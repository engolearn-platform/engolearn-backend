# ===============================================
# MongoDB Credentials & Database Setup
# ===============================================
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=secret123

APP_DB=engolearn_db
APP_USER=admin
APP_PASSWORD=admin123

# ===============================================
# Mongo Express Web UI Authentication
# ===============================================
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=admin123

# ===============================================
# Generic MongoDB JSON Importer
# ===============================================

# Optional URI override; must be reachable from a container on the Compose network.
# Leave empty to use the local MongoDB service with MONGO_USER and MONGO_PASS.
MONGO_IMPORT_URI=

# Target database; leave empty to reuse APP_DB.
MONGO_IMPORT_DATABASE=

# Existing _id behavior: skip (keep old), fail (abort before writes), replace (replace full document).
# WARNING: replace removes old fields missing from the incoming document.
MONGO_IMPORT_CONFLICT_POLICY=skip

# Positive integer: maximum documents in one bulk-write batch.
MONGO_IMPORT_BATCH_SIZE=500

# Continue with later batches/collections after a write error: true or false.
# Successful earlier batches are never rolled back.
MONGO_IMPORT_CONTINUE_ON_ERROR=false

# Require typing IMPORT before real writes: true or false.
MONGO_IMPORT_REQUIRE_CONFIRMATION=true

# Local manual testing: enables dev identities and Mongo transactions.
# Run the main compose replica on localhost:27017 before starting the backend.
spring.profiles.active=dev
