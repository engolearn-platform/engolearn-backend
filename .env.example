# ===============================================
# MongoDB Credentials & Database Setup
# ===============================================
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_REPLICA_SET=engolearn-rs
MONGO_USER=root
MONGO_PASS=secret123

APP_DB=engolearn_db
APP_USER=admin
APP_PASSWORD=admin123

# Speaking providers (set real values only in a local .env or deployment secret store)
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media module technical safeguards
MEDIA_MAX_UPLOAD_SIZE_BYTES=26214400
MEDIA_MAX_IMAGE_UPLOAD_SIZE_BYTES=10000000
MEDIA_PROTECTED_URL_LIFETIME=60s
MEDIA_MAX_MULTIPART_REQUEST_SIZE_BYTES=31457280
SPEAKING_DEV_SEED_FILE=

# Development helpers are opt-in and unavailable in prod.
PAYMENT_DEV_RESET_ENABLED=false
DEV_TOPIC_SEED_ENABLED=false
DEV_SPEAKING_FIXTURE_ENABLED=false
PLACEMENT_ALLOW_DRAFT=false
DEV_LOG_LEVEL=INFO
# Optional dev-only overrides for bundled media. Prod must use Media storage.
# PLACEMENT_MEDIA_DIRECTORY=./tools/mongo-json-importer/samples/placement-media
# ASSESSMENT_MEDIA_DIRECTORY=./tools/mongo-json-importer/samples/assessment-media

# ===============================================
# Mongo Express Web UI Authentication
# ===============================================
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=admin123

CORS_ALLOWED_ORIGINS=http://localhost:3000


AUTH_JWT_SECRET=replace-with-random-32-byte-minimum-secret
AUTH_JWT_ISSUER=engolearn
# Dev HTTP only. Prod always requires secure cookies.
AUTH_COOKIE_SECURE=false

# Real cookie auth is used in both profiles. Select dev or prod in the run command;
# do not put spring.profiles.active in .env. Both use real Placement Mongo persistence.
# tools/placement/setup-local.ps1 initializes a missing .env and JWT secret.
# MONGO_PORT is the host port; Compose uses mongodb:27017 internally.
# Use 27017 for host clients: the replica member advertises localhost:27017.
# Existing Docker volumes keep their original DB users/passwords; editing these
# variables does not recreate or reset users in an existing volume.
