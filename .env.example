# ===============================================
# MongoDB Credentials & Database Setup
# ===============================================
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=secret123

APP_DB=engolearn_db
APP_USER=admin
APP_PASSWORD=admin123

# Speaking providers (set real values only in a local .env or deployment secret store)
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SPEAKING_DEV_SEED_FILE=

# ===============================================
# Mongo Express Web UI Authentication
# ===============================================
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=admin123

CORS_ALLOWED_ORIGINS=http://localhost:3000


AUTH_JWT_SECRET=replace-with-random-32-byte-minimum-secret
AUTH_JWT_ISSUER=engolearn
# Local HTTP only. Set true behind HTTPS; dev profile already defaults to false.
AUTH_COOKIE_SECURE=false

# Default profile uses real user authentication. Do not activate dev for this flow.
# Run the main compose replica on localhost:27017 before starting the backend.
