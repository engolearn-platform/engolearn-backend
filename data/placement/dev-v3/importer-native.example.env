# PROPOSAL ONLY: environment settings for native mongosh running the shared JS entry.
# This file is NOT automatically read by import.ps1 or mongosh. Do not activate yet.
# import.ps1 runs mongosh in Docker: 127.0.0.1 there is the container, not this host.
MONGO_IMPORT_URI=mongodb://127.0.0.1:27017/
MONGO_IMPORT_DATABASE=engolearn_placement_dev_v3
MONGO_IMPORT_CONFLICT_POLICY=fail
MONGO_IMPORT_OBJECT_ID_FIELDS=none
MONGO_IMPORT_BATCH_SIZE=500
MONGO_IMPORT_CONTINUE_ON_ERROR=false
# Leave MONGO_IMPORT_APPLY unset for preflight. Set it to 1 only after explicit approval.
# Native JS does not implement the PowerShell wrapper's interactive confirmation.
