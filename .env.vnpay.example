# Copy these keys into the ignored backend .env; fill merchant values there.
# GET https://YOUR_PUBLIC_HOST/api/payment/vnpay/ipn -> local port 8080
VNPAY_ENABLED=false
VNPAY_WORKER_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return
VNPAY_SERVER_IP=
# Sandbox defaults; do not mix merchant credentials between environments.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
