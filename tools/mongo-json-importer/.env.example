# Generic MongoDB JSON Importer
# Tool-local settings. Copy this file to .env in this directory:
#   Copy-Item .\tools\mongo-json-importer\.env.example .\tools\mongo-json-importer\.env
# These settings are intentionally separate from the repository root .env.

# Optional MongoDB URI override. Leave empty to connect to the local Compose service.
# If set, the URI must be reachable from a temporary container on the Compose network.
# Example: mongodb://root:secret123@mongodb:27017/?authSource=admin
MONGO_IMPORT_URI=

# Target database. Leave empty to reuse APP_DB from the repository root .env.
MONGO_IMPORT_DATABASE=

# Existing _id behavior:
#   skip    - keep existing document; ignore incoming document
#   fail    - abort before any write if any incoming _id already exists
#   replace - replace the full existing document (destructive; absent fields are removed)
MONGO_IMPORT_CONFLICT_POLICY=skip

# Convert 24-character hexadecimal strings in matching fields to BSON ObjectId.
# Supports exact names and * wildcards. Arrays under matching *_ids fields are converted too.
# Set to "none" to disable. Only matching 24-hex strings are converted; other strings stay strings.
MONGO_IMPORT_OBJECT_ID_FIELDS=_id,*_id,*_ids

# Positive integer: max documents in one bulk-write batch.
MONGO_IMPORT_BATCH_SIZE=500

# Continue with later batches/collections after a write error: true or false.
# Earlier successful batches are NOT rolled back.
MONGO_IMPORT_CONTINUE_ON_ERROR=false

# Require typing IMPORT after preflight and before writing: true or false.
MONGO_IMPORT_REQUIRE_CONFIRMATION=true
